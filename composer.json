{
    "name": "prelumen/typo3-analytics",
    "description": "TYPO3 extension for Prelumen Analytics.",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "require": {
        "php": "^8.2",
        "prelumen/analytics-core": "^1.0",
        "typo3/cms-backend": "^12.4 || ^13.4",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-extbase": "^12.4 || ^13.4",
        "typo3/cms-fluid": "^12.4 || ^13.4",
        "typo3/cms-frontend": "^12.4 || ^13.4",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "typo3/testing-framework": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Oneco\\AnalyticsPro\\Typo3\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "prelumen_analytics"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:functional": "phpunit -c phpunit.functional.xml"
    },
    "autoload-dev": {
        "psr-4": {
            "Oneco\\AnalyticsPro\\Typo3\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit*",
            "/composer.lock",
            "/public",
            "/typo3temp",
            "/vendor",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/.Build"
        ]
    }
}
